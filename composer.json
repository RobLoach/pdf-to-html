{
    "name": "ahmaadkhader/pdf-to-html",
    "description": "Standalone PHP library for extracting semantic HTML from PDF files. Detects headings, lists, tables, links, and inline styles from PDF content.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ahmad Khader",
            "homepage": "https://github.com/Ahmaadkhader"
        }
    ],
    "require": {
        "php": ">=8.1",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ahmaadkhader\\PdfToHtml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ahmaadkhader\\PdfToHtml\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable"
}
